<script>
function toggle(id){document.getElementById(id).classList.toggle('open');}

const SECTIONS=['universal','preforeclosure','taxlien','auction','probate','vacant','handoff'];
function goTo(id){
  const el=document.getElementById(id);
  if(!el)return;
  const offset=document.querySelector('.nav-wrap').offsetHeight+8;
  const top=el.getBoundingClientRect().top+window.scrollY-offset;
  window.scrollTo({top,behavior:'smooth'});
  setActiveNav(id);
}
function setActiveNav(id){
  document.querySelectorAll('.nav-item').forEach(n=>{
    n.classList.toggle('active',n.getAttribute('onclick')?.includes("'"+id+"'"));
  });
  // scroll nav tab into view
  const active=document.querySelector('.nav-item.active');
  if(active)active.scrollIntoView({behavior:'smooth',block:'nearest',inline:'center'});
}
window.addEventListener('scroll',()=>{
  let current='universal';
  const offset=document.querySelector('.nav-wrap').offsetHeight+20;
  SECTIONS.forEach(id=>{
    const el=document.getElementById(id);
    if(el&&el.getBoundingClientRect().top<offset)current=id;
  });
  setActiveNav(current);
},{passive:true});
</script>
